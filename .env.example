# =============================================================================
# Sense — server configuration
# =============================================================================
# Copy this file to `.env` and adjust the values for your local setup.
# Every variable is optional; the server falls back to safe defaults.
#
# On macOS / Linux: `cp .env.example .env` then `export $(cat .env | xargs)`
# On macOS / Linux (one-shot): `set -a && source .env && set +a`
# In production: prefer a process supervisor (systemd, launchd, k8s) over
# dotenv files — env vars are the canonical config surface.
# =============================================================================


# -----------------------------------------------------------------------------
# Models (OpenAI-compatible; local default = Ollama at :11434)
# -----------------------------------------------------------------------------
# Pick ONE provider and set the matching MODEL. The three families are
# independent — you can mix (e.g. local LLM + cloud embedder + local VLM).
#
# Any OpenAI-compatible endpoint works: Ollama, mlx_lm.server, vLLM,
# LM Studio, OpenAI, Anthropic-via-OpenAI-proxy, etc.

# --- LLM (the agent's reasoning) ---
# SENSE_LLM_PROVIDER=mlx              # mlx | openai | ollama | …
SENSE_LLM_MODEL=                     # e.g. qwen2.5:7b, gpt-4o-mini, llama3.2
SENSE_LLM_BASE_URL=http://localhost:11434/v1
SENSE_LLM_API_KEY=                   # leave blank for local providers
SENSE_LLM_TEMPERATURE=0.2

# --- Embedder (vector search) ---
SENSE_EMBED_MODEL=                   # e.g. nomic-embed-text, text-embedding-3-small
SENSE_EMBED_BASE_URL=http://localhost:11434/v1
SENSE_EMBED_API_KEY=

# --- VLM (image atoms) — only used if you ingest images ---
# SENSE_VLM_MODEL=                   # e.g. qwen2.5-vl
# SENSE_VLM_BASE_URL=http://localhost:11434/v1
# SENSE_VLM_API_KEY=


# -----------------------------------------------------------------------------
# Cognitive read path — policy thresholds
# -----------------------------------------------------------------------------
# These numbers control when the agent acts autonomously, when it asks
# the user to confirm, and how many requests a session can make per
# minute. Bumping ``SENSE_CONFIDENCE_AUTONOMOUS`` higher makes the agent
# more cautious; lowering it makes the agent more autonomous. The
# ``CONFIRM`` floor must be strictly below ``AUTONOMOUS``.

# Default if unset: 0.85
# SENSE_CONFIDENCE_AUTONOMOUS=0.85

# Default if unset: 0.60
# SENSE_CONFIDENCE_CONFIRM=0.60

# Default if unset: 20
# SENSE_RATE_LIMIT_PER_MIN=20


# -----------------------------------------------------------------------------
# Gateway runtime
# -----------------------------------------------------------------------------
# The bearer token is auto-generated on first run and stored in
# data/server_token. You only need to override this if you're migrating
# a token between machines.
# SENSE_TOKEN_FILE=data/server_token

# The Ed25519 signing key is auto-generated on first run and stored in
# data/server_ed25519.key. Same migration rule as the token.
# SENSE_KEY_FILE=data/server_ed25519.key
