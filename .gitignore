# --- Secrets / runtime data (NEVER commit) ---
.env
.env.*
!.env.example
server/data/*.key
server/data/*.db
server/data/*.db-*
server/data/server_token
**/server_ed25519.key

# --- Python ---
server/.venv/
**/__pycache__/
**/*.pyc
server/.pytest_cache/
*.egg-info/
build/
dist/

# --- ESP-IDF / firmware ---
firmware/*/build/
firmware/*/managed_components/
firmware/*/.cache/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
**/dependencies.lock
!firmware/openrecall_sensor/dependencies.lock
!firmware/openrecall_selftest/dependencies.lock

# --- Android / Gradle ---
android/**/.gradle/
android/**/.kotlin/
android/**/build/
android/**/local.properties
android/local.properties
*.apk
*.aab

# --- macOS ---
.DS_Store

# --- SDD scratch (progress ledger is git-ignored scratch) ---
.superpowers/sdd/

# --- Internal AI-assisted planning docs (kept local, not published) ---
docs/superpowers/

# --- Editor ---
.idea/
.vscode/
# --- Claude Design tool artefacts ---
android/**/design/.thumbnail
