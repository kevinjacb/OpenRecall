# OpenRecall — IDF defaults tuned for the XIAO ESP32S3 Sense.
# These are starting points; run `idf.py menuconfig` to confirm exact keys for your
# IDF version. Rationale in comments.

# --- Flash + PSRAM (8 MB flash; 8 MB Octal PSRAM on the Sense) ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# --- Partition table: custom single-app, 3 MB factory ---
# P4b adds esp_wifi + esp_http_server to the ~1 MB audio/BLE image; the built-in
# single-app table (1 MB factory) overflows. Custom partitions.csv gives a 3 MB
# factory app (~2 MB headroom). 8 MB flash, no OTA in this project.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Choose "Make RAM allocatable using heap_caps_malloc(..., MALLOC_CAP_SPIRAM)"
# (NOT "Make RAM allocatable using malloc() as well"). With SPIRAM_USE_MALLOC
# enabled, all malloc() allocations — including the FreeRTOS Queue_t structs
# backing NimBLE's recursive mutexes and event queues — can land in Octal
# PSRAM. On S3 the PSRAM controller's cache-coherency window is narrow under
# load (the audio task reads from PSRAM at ~50 KB/s while the NimBLE host is
# dispatching HCI events), and a PSRAM-backed Queue_t can be read with a
# stale uxItemSize after the cache invalidates. That trips the assert at
# xQueueSemaphoreTake queue.c:1713 (uxItemSize == 0) and kills the
# connection path. With SPIRAM_USE_CAPS_ALLOC (and not SPIRAM_USE_MALLOC),
# all system-level allocations (encoder state, NimBLE mbufs/queues/mutexes,
# GATT DB) live in internal SRAM. The audio ring buffer is the only thing
# that needs PSRAM, and it requests it explicitly via
# heap_caps_malloc(..., MALLOC_CAP_SPIRAM) in ring_buffer.c.
#
# Note: SPIRAM_USE is a Kconfig choice with default SPIRAM_USE_MALLOC. You
# can't disable the default with `# CONFIG_SPIRAM_USE_MALLOC is not set`
# alone — the choice still picks the default. You have to set the desired
# option (CONFIG_SPIRAM_USE_CAPS_ALLOC=y) AND clear the default.
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# CONFIG_SPIRAM_USE_MALLOC is not set
# CONFIG_SPIRAM_USE_MEMMAP is not set

# --- CPU / scheduler ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# Opus encode is the hot path; optimise for speed (Spike 1 budget assumed -O2).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Bluetooth: NimBLE peripheral (much lighter RAM/flash than Bluedroid) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# BROADCASTER role is unused — Sense is a peripheral. Setting it allocates an
# extra advertising set we never use.
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Big ATT MTU so a 1 s §C.6 chunk needs few notifications; pair with 2M PHY + DLE
# (negotiated at runtime) for the ~300-700 kbps sustained audio path.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# All system-level allocations (NimBLE mbufs, queues, mutexes, encoder state,
# GATT DB) live in internal SRAM because we left CONFIG_SPIRAM_USE_MALLOC off
# above. The two settings below are kept as belt-and-suspenders defaults so
# that if SPIRAM_USE_MALLOC is ever re-enabled, NimBLE's controller
# allocations go to internal RAM and the DMA carveout reserves enough
# internal memory for the BT controller's HCI buffers.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Disable BLE 5.0 extended features. NimBLE 1.7 / IDF 6.0 enables them by
# default, but the XIAO ESP32S3 Sense's BT controller ROM (older ECOs) walks
# a feature table that isn't fully populated for every BLE 5.0 capability.
# Walking into a NULL entry inside btdm_controller_init produces the
# EXCVADDR=0x0 LoadProhibited panic this config sidesteps. Sense only needs
# the §C.6 audio path — BLE 4.2 is sufficient.
# (Idf.py menuconfig path: NimBLE Options → BLE 5.0 feature support → off)
# (Equivalent older key: CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT.)
# Use the `# ... is not set` form so the kconfig system actually clears a
# value another option is selecting on.
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set

# Run NimBLE's internal timers on its own dedicated task instead of the
# esp_timer task. With BT_NIMBLE_USE_ESP_TIMER=y, every NimBLE internal
# periodic event is dispatched from the esp_timer task. On first boot the
# NimBLE host task is still spinning up its GATT/advertising state machine;
# if the timer fires before the host task is draining, the event queue
# fills, the next esp_timer callback blocks in a critical section waiting
# to enqueue, and the interrupt watchdog fires after 300 ms — exactly the
# "Interrupt wdt timeout on CPU0" panic with backtrace
#   spinlock_acquire → xPortEnterCriticalTimeout → xQueueGenericSend →
#   npl_freertos_eventq_put → ble_npl_eventq_put
# that this config sidesteps. NimBLE's own timer thread is a dedicated
# FreeRTOS task that handles the timer queue separately.
# CONFIG_BT_NIMBLE_USE_ESP_TIMER is not set

# Bump the NimBLE host task stack from the 4 KB default. The 4 KB is just
# enough for the steady-state host loop but overflows on the first
# connection setup or when running the on_sync callback under load. 8 KB
# gives the GATT DB init + advertising setup the headroom they need.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# --- FatFS: Long Filename Support (required by P4b SD capture) ---
# The P4b snapshot/video paths use names that exceed 8.3: the "snapshots" dir
# (9 chars), clip/snapshot filenames "%010<rel_ts>_<seq>.jpg" (13-char name),
# and ".mjpeg" (5-char ext). With the IDF default LFN_NONE, f_mkdir/f_open on
# these returns FR_INVALID_NAME -> EINVAL, so every capture silently fails.
# LFN_HEAP mallocs the LFN workspace (safer than LFN_STACK across the multiple
# tasks that touch FatFS: app_main, executor, video task, transfer task). Code
# page 437 (ASCII) covers our numeric/ASCII paths.
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
